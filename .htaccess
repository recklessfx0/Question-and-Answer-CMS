Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|config|core|database|storage|views)(?:/|$) - [F,L]
    RewriteRule ^public-assets/.*\.(?:php|phtml|phar)$ - [F,L]
    RewriteRule ^(?:queue-worker\.php|README\.md)$ - [F,L]
    RewriteRule ^(robots\.txt|llms\.txt|sitemap(?:_index)?\.xml)$ index.php [L]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
